
@startuml 管理员新增图书时序图

skinparam sequenceMessageAlign center
skinparam noteBackgroundColor #e2f0ff
skinparam noteBorderColor #2d8cf0

actor 管理员
participant "图书管理界面" as UI
participant "BookController" as Controller
participant "BookService" as Service
database "BookMapper" as Mapper
database "数据库" as DB

管理员 -&gt; UI: 点击新增图书
activate UI
UI -&gt; UI: 显示新增表单
UI -&gt; 管理员: 填写图书信息

管理员 -&gt; UI: 提交表单
UI -&gt; Controller: POST /book/add
activate Controller
Controller -&gt; Service: add(Book)
activate Service
Service -&gt; Mapper: insert(Book)
activate Mapper
Mapper -&gt; DB: INSERT INTO book
activate DB
DB --&gt; Mapper: 返回插入结果
deactivate DB
Mapper --&gt; Service: 返回影响行数
deactivate Mapper

alt 新增成功
    Service --&gt; Controller: 返回成功
    Controller --&gt; UI: 重定向到列表页
    UI -&gt; UI: 刷新列表
    UI --&gt; 管理员: 显示新增成功
else 新增失败
    Service --&gt; Controller: 返回失败
    Controller --&gt; UI: 提示错误
    UI --&gt; 管理员: 显示错误信息
end

deactivate Service
deactivate Controller
deactivate UI

@enduml
