# 本地开发配置模板
#
# 用法：
#   1. 把本文件复制为同目录下的 application-local.properties
#   2. 填入你自己的数据库账号密码
#   3. 启动时指定 profile：local
#
#     ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# application-local.properties 已在 .gitignore 中，不会被提交。
spring.datasource.username=root
spring.datasource.password=你的数据库密码
